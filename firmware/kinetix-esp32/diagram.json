{
  "version": 1,
  "author": "Talpa Systems",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-mpu6050", "id": "imu", "top": -140, "left": 160, "attrs": {} },
    { "type": "wokwi-ds1307", "id": "rtc", "top": -140, "left": 330, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": 60, "left": 330, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-dht22", "id": "dht", "top": -150, "left": -140, "attrs": { "temperature": "22", "humidity": "55" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": 230, "left": -230, "attrs": { "lux": "1" } },
    { "type": "wokwi-led", "id": "ledOk", "top": 200, "left": 200, "attrs": { "color": "limegreen", "label": "OK" } },
    { "type": "wokwi-led", "id": "ledAlert", "top": 200, "left": 250, "attrs": { "color": "red", "label": "ALERTA" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 280, "left": 180, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 280, "left": 230, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 320, "left": 20, "attrs": { "color": "yellow", "label": "SEM SINAL" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "imu:VCC", "esp:3V3", "red", [] ],
    [ "imu:GND", "esp:GND.2", "black", [] ],
    [ "imu:SDA", "esp:21", "blue", [] ],
    [ "imu:SCL", "esp:22", "purple", [] ],
    [ "imu:AD0", "esp:3V3", "orange", [] ],

    [ "rtc:5V", "esp:3V3", "red", [] ],
    [ "rtc:GND", "esp:GND.2", "black", [] ],
    [ "rtc:SDA", "esp:21", "blue", [] ],
    [ "rtc:SCL", "esp:22", "purple", [] ],

    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "oled:GND", "esp:GND.2", "black", [] ],
    [ "oled:SDA", "esp:21", "blue", [] ],
    [ "oled:SCL", "esp:22", "purple", [] ],

    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.1", "black", [] ],
    [ "dht:SDA", "esp:15", "green", [] ],

    [ "ldr:VCC", "esp:3V3", "red", [] ],
    [ "ldr:GND", "esp:GND.1", "black", [] ],
    [ "ldr:AO", "esp:34", "yellow", [] ],

    [ "esp:26", "ledOk:A", "green", [] ],
    [ "ledOk:C", "r1:1", "black", [] ],
    [ "r1:2", "esp:GND.3", "black", [] ],
    [ "esp:27", "ledAlert:A", "red", [] ],
    [ "ledAlert:C", "r2:1", "black", [] ],
    [ "r2:2", "esp:GND.3", "black", [] ],

    [ "btn:1.l", "esp:4", "yellow", [] ],
    [ "btn:2.l", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
